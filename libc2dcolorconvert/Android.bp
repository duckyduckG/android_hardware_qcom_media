cc_library_shared {
    name: "libc2dcolorconvert",
    sanitize: {
        integer_overflow: true,
    },
    vendor: true,

    srcs: [
        "C2DColorConverter.cpp",
    ],

    cflags: [
        "-Werror",
    ] + select(soong_config_variable("ANDROID", "target_board_platform"), {
        "msmnile": ["-DVIDC_NV12_ALIGN"],
        default: [],
    }),

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libdl",
        "liblog",
    ],
}

cc_library_headers {
    name: "libc2dcolorconvert_headers",
    export_include_dirs: ["."],
    vendor: true,
}
